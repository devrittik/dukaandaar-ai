# Persistent storage is the default. A replica set (rs0) is recommended for full multi-document atomicity.
# Standalone MongoDB is also supported with guarded writes and compensating rollback.
# For Atlas/another MongoDB deployment, replace MONGODB_URI with its connection string.
STORAGE_DRIVER=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=dukaandaar
SHOP_ID=shop_001
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# rules | ollama | hosted
# Ollama and hosted providers fall back to the deterministic rule parser on errors/timeouts.
LLM_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# true enables model reasoning for Ollama and OpenRouter; false keeps it off.
LLM_THINKING_MODE=false
LLM_TIMEOUT_MS=8000
# Hosted mode expects an OpenAI-compatible chat-completions endpoint.
HOSTED_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
HOSTED_LLM_MODEL=google/gemini-3.7-flash
HOSTED_LLM_API_KEY=

# Optional hosted voice API chain. API keys stay on the server and are never returned to the client.
# If configured, the server tries providers in order, then Sherpa-ONNX; the browser is the final client fallback.
# Audio/text are sent to hosted vendors when their credentials are set. Leave keys blank for offline/browser-only speech.
VOICE_STT_PROVIDER_ORDER=elevenlabs,deepgram,sherpa-onnx
VOICE_TTS_PROVIDER_ORDER=elevenlabs,deepgram,sherpa-onnx
# Blank follows the app's selected conversation language; "auto" requests language detection from STT providers.
VOICE_STT_LANGUAGE=
SPEECH_PROVIDER_TIMEOUT_MS=60000

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_OUTPUT_FORMAT=wav_16000

DEEPGRAM_API_KEY=
# Change to your account's regional endpoint if needed, e.g. https://api.in.deepgram.com/v1.
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_CONTAINER=wav
DEEPGRAM_TTS_SAMPLE_RATE=24000

# Sherpa-ONNX runs on the API server. Its Node/WebAssembly package is installed with npm; no CMake build is needed.
# Set these to the three files from a compatible Sherpa-ONNX Whisper ONNX model bundle (not GGML .bin files).
SHERPA_ONNX_WHISPER_ENCODER_PATH=
SHERPA_ONNX_WHISPER_DECODER_PATH=
SHERPA_ONNX_WHISPER_TOKENS_PATH=
# Leave blank to use the conversation language selected in the app; set to "auto" to let multilingual Whisper detect it.
SHERPA_ONNX_WHISPER_LANGUAGE=

# Sherpa-ONNX Supertonic 3 multilingual TTS model bundle directory (contains the seven files listed in README.md).
SHERPA_ONNX_TTS_MODEL_DIR=
# Optional synthesis tuning: speaker 0-9, speed 0.5-2.0, steps 1-32.
SHERPA_ONNX_TTS_SPEAKER_ID=0
SHERPA_ONNX_TTS_SPEED=1
SHERPA_ONNX_TTS_NUM_STEPS=8
# Supertonic supports 31 languages; cloud TTS support depends on the configured provider, model, and voice.

# Guards for local Sherpa process/runtime cost. 16 kHz mono PCM uses roughly 1.92 MB per minute.
SPEECH_ENGINE_TIMEOUT_MS=600000
SPEECH_MAX_AUDIO_SECONDS=1800
SPEECH_MAX_AUDIO_BYTES=67108864
