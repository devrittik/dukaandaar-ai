# Copy to server/.env for a hosted deployment. Startup refuses production until required values are populated.
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://your-frontend.example.com

# Use a hosted MongoDB URI (Atlas or equivalent); the shared control DB keeps accounts/sessions.
# Business data uses one dedicated database per shop: <prefix><shop_id>.
STORAGE_DRIVER=mongo
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.example.com/?retryWrites=true&w=majority
MONGODB_DB=dukaandaar
MONGODB_SHOP_DB_PREFIX=dukaandaar_

# Production requires a hosted LLM endpoint and API key. Rule-based parsing remains the safety fallback on provider failure.
LLM_PROVIDER=hosted
HOSTED_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
HOSTED_LLM_MODEL=google/gemini-3.7-flash
HOSTED_LLM_API_KEY=
LLM_THINKING_MODE=false
LLM_TIMEOUT_MS=8000

# Production requires hosted STT and TTS. At least one configured provider per capability must be listed.
VOICE_MODE=hosted
VOICE_STT_PROVIDER_ORDER=elevenlabs,deepgram
VOICE_TTS_PROVIDER_ORDER=elevenlabs,deepgram
SPEECH_PROVIDER_TIMEOUT_MS=60000
# Optional hosted STT language override; blank follows the app-selected language, "auto" requests provider detection.
VOICE_STT_LANGUAGE=

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=

DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_CONTAINER=wav
DEEPGRAM_TTS_SAMPLE_RATE=24000
